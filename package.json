{
  "name": "violetlink",
  "version": "1.0.0",
  "description": "Open-source, mobile-first last-mile platform for DMRC Violet Line stations in Faridabad",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/podMatching.test.js tests/rideStateMachine.test.js tests/nearestDriver.test.js tests/atomicAcceptance.test.js tests/roleBasedAccess.test.js tests/razorpaySignature.test.js",
    "validate-data": "node scripts/validate-data.js"
  },
  "keywords": [
    "hacktoberfest",
    "dmrc",
    "violet-line",
    "last-mile",
    "ride-pooling",
    "faridabad",
    "transit",
    "safety"
  ],
  "author": "VioletLink Contributors",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
