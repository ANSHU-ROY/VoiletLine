# VioletLink Environment Variables Configuration
# Copy this file to .env to customize settings.
# NOTE: Zero API keys are required for local mock mode!

# Server & Client Port
PORT=3000
NODE_ENV=development

# Authentication Secrets (Development default provided)
JWT_SECRET=violetlink_dev_jwt_secret_key_change_in_production_998877

# Razorpay Test Mode Credentials (OPTIONAL: Mock payments active if left empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database Connection (OPTIONAL: In-memory/SQLite active if left empty)
# Format: postgresql://user:pass@host:port/dbname?sslmode=require
DATABASE_URL=

# Fast2SMS / SMS Gateway Key (OPTIONAL: Console OTP active if left empty)
SMS_GATEWAY_API_KEY=

# Telegram Bot API (OPTIONAL: Console mock dispatcher active if left empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DISPATCH_CHAT_ID=

# Simulation Flags
SIMULATOR_ENABLED=true
MOCK_PAYMENTS=true
MOCK_SMS=true
MOCK_DISPATCH=true
